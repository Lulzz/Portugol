algoritmo "NomeDoAlgoritmo"
var
   i, f: inteiro

inicio
   escreva("INICIO: ")
   leia(i)

   escreva("FIM: ")
   leia(f)

    se(i < f)entao

        enquanto(i <= f) faca
            escreva(i)
            i <- i + 1
        fimenquanto

    senao

        enquanto(i >= f)faca
            escreva(f)            
            f <- f + 1
        fimenquanto

    fimse

fimalgoritmo