algoritmo "apo005"
var
   // declare suas variáveis aqui
   N1, N2, F: inteiro
inicio
   // seu código aqui
    escreva("informe num1: ")
     leia(N1)
    
     escreva("informe num2: ")
     leia(N2)
    
     F <- (N1 + N2)/2
    
     escreva("A média entre ", N1," e ", N2," é: ", F)
fimalgoritmo