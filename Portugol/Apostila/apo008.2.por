algoritmo "NomeDoAlgoritmo"
var
   D: real
inicio
   escreva("Digite uma distancia em metros:")
   leia(D)

   escreval(D, " metros corresponde a:", D / 1000, " Quilometros")
   escreval(D, " metros corresponde a:", D / 100, " Hectometros")
   escreval(D, " metros corresponde a:", D / 10, " Decametros")
   escreval(D, " metros corresponde a:", D * 10, " Decimetros")
   escreval(D, " metros corresponde a:", D * 100, " Centimetros")
   escreval(D, " metros corresponde a:", D * 1000, " Milimetros")
fimalgoritmo