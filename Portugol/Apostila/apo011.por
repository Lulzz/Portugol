algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui  
   A, B, C, D: real
inicio
   // seu código aqui
    escreva("Digite o valor de A: ")
    leia(A)
    escreva("Digite o valor de B: ")
    leia(B)
    escreva("Digite o valor de C: ")
    leia(C)

    D <- (B^2) - (4 * A * C)
     escreva("O valor de D é: ", D)
fimalgoritmo