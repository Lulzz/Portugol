algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui   
   Nun1, A, S: inteiro
inicio
   // seu código aqui
    escreval("informe um numero:")
    leia(Nun1)

    A <- Nun1 - 1
    S <- Nun1 + 1

    escreval("o antecessor de ", Nun1," é: ", A)
    escreval("o sucessor de ", Nun1," é: ", S)

fimalgoritmo