algoritmo "apo003"
var
   // declare suas variáveis aqui
   Nome: caractere
   Sal: inteiro
inicio
   // seu código aqui
   escreva("Qual o seu nome: ")
   leia(Nome)

    escreva("Qual o seu salario: ")
    leia(Sal)

    escreva("O funcionairo ", Nome," tem um salario de R$", Sal)
fimalgoritmo