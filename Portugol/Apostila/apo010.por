algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   L, A, T: real

inicio
   // seu código aqui
   escreva("Qual a altura: ")
   leia(A)

   escreva("Qual a largura:")
   leia(L)

   T <- (L * A)/2

   escreva("Vai precisar de ", T, " litros de tinta para pintar a parede")
fimalgoritmo