algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
    Nun1, D, T: real
inicio
   // seu código aqui
    escreval("qual numero:")
    leia(Nun1)

     D <- Nun1 * 2
     T <- Nun1 / 3

    escreval("O dobro de ", Nun1,"é :", D)
    escreval("A terça parte de", Nun1,"é: ", T)
fimalgoritmo