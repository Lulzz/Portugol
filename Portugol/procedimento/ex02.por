algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   n: inteiro
   procedimento contar(n: inteiro)
   var
      i: inteiro
   inicio
      escreva("Ate qual numero voce quer digitar: ")
      leia(n)
      para i de 1 ate n faça
       escreval(i)
    fimpara
   fimprocedimento

inicio
contar()
fimalgoritmo