algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui

    

   procedimento linha()
   var
      // variáveis locais
      i: inteiro
   inicio
      // código
        para i de 1 ate 30 faca
           escreva("=")
        fimpara
        escreval("")

   fimprocedimento

inicio
   // seu código aqui
    linha()
    escreval("Bem vindo ao sistema!")
    linha()

fimalgoritmo
