algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   N1, N2, M: real
inicio
   // seu código aqui
   escreva("Digite um numero:")
   leia(N1)

   escreva("Digite outro numero: ")
   leia(N2)

    M<- (N1+N2)/2

    escreva("A média entre ", N1, " e ", N2, "é igual a ", M)
fimalgoritmo