algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   N: caractere
inicio
   // seu código aqui
   escreva("Escreva seu nome: ")
   leia(N)

   escreval("Total de letras do seu nome: ", compr(N))
   escreval("copia do seu nome: ", copia(N, 2, 2))
   escreval("maiuscula letras do seu nome: ", maiuscula(N))
   escreval("minuscula letras do seu nome: ", minuscula(N))
   escreval("pos letras do seu nome: ", pos("a", N))
   escreval("asc do seu nome: ", asc("c"))
   escreval("asc letras do seu nome: ", carac(67))
fimalgoritmo