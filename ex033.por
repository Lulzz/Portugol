algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   x, y : inteiro

   procedimento soma(a: inteiro; b: inteiro)
   var
      // variáveis locais
   inicio
      // código
        res <- a+b
      escreva("o reusltaodo ", a, " mais ", b," é igual a: ", res)

   fimprocedimento
inicio
   // seu código aqui
   x <- 5
   y <- 3
   soma(x, y)0
fimalgoritmo