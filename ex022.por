algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   N, R, soma: inteiro

inicio
   // seu código aqui
   soma <- 1

      escreva("Qual o valor que voce quer multiplicar? ")
      leia(N)

   repita
         R <- n * soma
         escreval(n, "X", soma, " = ", R)
         soma <- soma + 1
   ate (soma > 10)
fimalgoritmo