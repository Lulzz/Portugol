algoritmo "NomeDoAlgoritmo"
var
    contador, valor, salto: inteiro
inicio
   contador <- 0 

   escreva("até quanto voce quer contar: ")
   leia(valor)

   escreval("Qual o valor do salto")
   leia(salto)
 
   enquanto(contador <= valor) faca
        escreval(contador)
        contador <- contador + salto
   fimenquanto

fimalgoritmo