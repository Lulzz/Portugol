algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   v1,v2, res: inteiro

   funcao soma(n1,n2: inteiro) : inteiro
   var
      // variáveis locais
   inicio
      retorne n1 + n2
   fimfuncao
inicio
   // seu código aqui
   escreva("Digite um valor: ")
   leia(v1)
   escreva("Digite um valor: ")
   leia(v2)
    res<- soma(v1,v2)
    escreval("O resultado da soma é ", res)
    escreval("O resultado da soma é ", soma(v1,v2))

fimalgoritmo