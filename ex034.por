algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   N1: inteiro

   procedimento Parouimpar(PI: inteiro)
   var
      // variáveis locais
   inicio
      // código
      se(pi%2 = 0)entao
        escreval("este numero é par: ", PI)
      senao 
       escreval("este numero é impar: ", PI)
       fimse
   fimprocedimento
inicio
   // seu código aqui
para i de 1 ate 5 faça
   escreval("Escreva um nuemro: ")
   leia(N1)
    Parouimpar(N1)
fimpara

fimalgoritmo