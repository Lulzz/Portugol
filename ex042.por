algoritmo "NomeDoAlgoritmo"
var
   // declare suas variáveis aqui
   V : vetor[1..4] de inteiro
   N: inteiro

inicio
   // seu código aqui
   para i de 1 ate 4 faça
        escreva("Difite um valor: ")
        leia(N)
        v[i] <- N
   fimpara

   para i de 1 ate 4 faça
      escreva(v[i] ," ")
   fimpara
fimalgoritmo